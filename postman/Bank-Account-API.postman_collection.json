                  "pm.test('HTTP 200 OK', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "if (pm.response.code !== 200) { return; }",
                  "const j = pm.response.json();",
                  "pm.test('Mensaje de éxito', function () {",
                  "    pm.expect(j.message).to.include('successfully');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 50.0\n}"
            },
            "url": "{{baseUrlCmd}}/api/v1/depositFunds/{{accountId}}",
            "description": "`id` en la ruta; cuerpo: `{ \"amount\": number }`."
          },
          "response": []
        }
      ]
    },
